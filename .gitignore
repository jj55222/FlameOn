# Environment
.env
*.pyc
__pycache__/
.venv/
venv/

# Google API credentials (never commit these)
gdoc_token.json
gdoc_credentials.json
gdoc_state.json

# Brave API billing state (machine-specific, auto-generated)
brave_quota.json

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Output artifacts (large files, regeneratable)
*.wav
*.mp3
*.mp4
*.webm
*.m4a
*.sqlite
*.db
*.jsonl.tmp
*.html
*.pdf

# FlameOn experiment artifacts
autoresearch/.cache/
autoresearch/.runs/
autoresearch/.artifacts/
autoresearch/.tmp/
autoresearch/.logs/

# Repo-root artifact directories accepted by the CaseGraph CLI's
# --bundle-out safe-path policy (BUNDLE_SAFE_DIRS in
# pipeline2_discovery/casegraph/cli.py). Without these, operator
# bundles written to e.g. .tmp/portal_live/.../bundle.json get
# captured by the auto-commit hook.
.cache/
.runs/
.artifacts/
.tmp/
.logs/

# Claude Code local settings
.claude/settings.local.json
